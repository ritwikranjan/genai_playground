# Azure OpenAI Configuration
# Copy this file to .env and fill in your values

# Required: Your Azure OpenAI endpoint
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/

# Required: Your Azure OpenAI API key
AZURE_OPENAI_API_KEY=your-api-key-here

# Optional: API version (defaults to 2024-02-15-preview)
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Optional: Default deployment name (can also be specified per-request)
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Azure Data Explorer (for ADX tool)
# Authentication uses DefaultAzureCredential which checks:
# 1. Environment variables (AZURE_CLIENT_ID, AZURE_CLIENT_SECRET, AZURE_TENANT_ID)
# 2. Azure CLI login (az login)
# 3. Managed Identity (when running in Azure)
# 4. Visual Studio Code Azure extension login
